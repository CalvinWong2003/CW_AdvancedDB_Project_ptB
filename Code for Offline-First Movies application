  <!-- TOAST NOTIFICATION CONTAINER -->
  <div id="toastContainer" class="fixed bottom-4 right-4 z-50 flex flex-col space-y-2 pointer-events-none"></div>

  <!-- APPLICATION LOGIC SCRIPT -->
  <script>
    // ==========================================
    // 1. DATABASE INITIALIZATION & CONFIGURATION
    // ==========================================
    const LOCAL_DB_NAME = 'local_movies_db';
    const VIRTUAL_REMOTE_DB_NAME = 'virtual_remote_movies_db';

    // Local PouchDB instance (backed by IndexedDB)
    let localDB = new PouchDB(LOCAL_DB_NAME);

    // Remote target instance: defaults to virtual browser instance for instant demo
    let remoteDB = new PouchDB(VIRTUAL_REMOTE_DB_NAME);
    let syncHandler = null;
    let isLiveSyncActive = true;
    let isNetworkOnline = navigator.onLine !== undefined ? navigator.onLine : true;
    let isSimulatedOffline = false;

    // In-memory cache of current local docs for fast filtering
    let cachedMovies = [];

    // ==========================================
    // 2. LIFECYCLE & EVENT LISTENERS
    // ==========================================
    window.addEventListener('DOMContentLoaded', async () => {
      logTerminal('System boot: Initializing local PouchDB instance...', 'info');
      
      // Listen to real physical browser network events
      window.addEventListener('online', () => {
        if (!isSimulatedOffline) updateNetworkStatusUI(true);
      });
      window.addEventListener('offline', () => {
        updateNetworkStatusUI(false);
      });

      // Initialize UI network state
      updateNetworkStatusUI(isNetworkOnline);

      // Start initial replication
      startReplicationEngine();

      // Seed sample data if local DB is completely empty
      await seedInitialDataIfEmpty();

      // Load initial local data
      await refreshLocalMovies();
      await updateRemoteDocCount();
    });

    // ==========================================
    // 3. REPLICATION CONTROLLER
    // ==========================================
    function startReplicationEngine() {
      if (syncHandler) {
        syncHandler.cancel();
        syncHandler = null;
      }

      if (!isLiveSyncActive || isSimulatedOffline || !isNetworkOnline) {
        updateSyncBadge('idle', 'Replication Suspended (Offline)');
        logTerminal('Sync Engine: Replication suspended (offline or paused)', 'warn');
        return;
      }

      updateSyncBadge('syncing', 'Sync Active (Replicating)');
      logTerminal('Sync Engine: Spawning bi-directional replication with remote...', 'info');

      try {
        syncHandler = PouchDB.sync(localDB, remoteDB, {
          live: true,
          retry: true
        })
        .on('change', (info) => {
          logTerminal(`Replication delta transferred: ${info.direction} (${info.change.docs.length} docs, rev: ${info.change.docs[0]._rev})`, 'success');
          refreshLocalMovies();
          updateRemoteDocCount();
        })
        .on('paused', (err) => {
          if (err) {
            updateSyncBadge('error', 'Replication Error');
            logTerminal(`Replication paused with error: ${err.message}`, 'error');
          } else {
            updateSyncBadge('active', 'Replication Idle (In Sync)');
            logTerminal('Replication up to date; waiting for local/remote changes...', 'info');
          }
        })
        .on('active', () => {
          updateSyncBadge('syncing', 'Replication Active');
          logTerminal('Replication stream resumed active data exchange.', 'info');
        })
        .on('denied', (err) => {
          updateSyncBadge('error', 'Sync Denied');
          logTerminal(`Replication denied: ${err}`, 'error');
        })
        .on('complete', (info) => {
          updateSyncBadge('idle', 'Replication Completed');
          logTerminal('Replication process completed lifecycle.', 'info');
        })
        .on('error', (err) => {
          updateSyncBadge('error', 'Sync Failed');
          logTerminal(`Replication stream fatal error: ${err.message}`, 'error');
        });
      } catch (err) {
        logTerminal(`Failed to initialize sync: ${err.message}`, 'error');
        updateSyncBadge('error', 'Config Error');
      }
    }

    function toggleLiveSync() {
      isLiveSyncActive = !isLiveSyncActive;
      const btn = document.getElementById('toggleLiveSyncBtn');
      const txt = document.getElementById('liveSyncBtnText');

      if (isLiveSyncActive) {
        btn.className = "w-full py-2 bg-cyan-600/20 hover:bg-cyan-600/30 text-cyan-300 border border-cyan-500/30 text-xs rounded-xl font-medium transition flex items-center justify-center space-x-1.5";
        txt.innerText = "Live Sync: ON";
        showToast('Live bidirectional replication turned ON', 'info');
        startReplicationEngine();
      } else {
        btn.className = "w-full py-2 bg-slate-800 hover:bg-slate-700 text-slate-400 border border-slate-700 text-xs rounded-xl font-medium transition flex items-center justify-center space-x-1.5";
        txt.innerText = "Live Sync: OFF";
        if (syncHandler) {
          syncHandler.cancel();
          syncHandler = null;
        }
        updateSyncBadge('idle', 'Replication Manually Paused');
        showToast('Live replication turned OFF', 'info');
      }
    }

    async function triggerManualSync() {
      if (isSimulatedOffline) {
        showToast('Cannot sync while Network is set to Offline!', 'error');
        return;
      }
      showToast('Initiating manual one-time replication sync...', 'info');
      logTerminal('Executing manual one-off PouchDB.sync()...', 'info');
      try {
        const res = await PouchDB.sync(localDB, remoteDB);
        logTerminal(`Manual sync completed successfully. Pull: ${res.pull.docs_written}, Push: ${res.push.docs_written}`, 'success');
        showToast('Manual sync finished with parity!', 'success');
        await refreshLocalMovies();
        await updateRemoteDocCount();
      } catch (err) {
        logTerminal(`Manual sync failed: ${err.message}`, 'error');
        showToast(`Manual sync error: ${err.message}`, 'error');
      }
    }

    function toggleSyncMode(mode) {
      const liveContainer = document.getElementById('liveUrlContainer');
      const badge = document.getElementById('engineModeBadge');

      if (mode === 'live') {
        liveContainer.classList.remove('hidden');
        badge.innerText = 'Live Remote CouchDB';
        badge.className = 'text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-emerald-950 text-emerald-300 border border-emerald-800';
        
        const url = document.getElementById('remoteCouchUrl').value.trim() || 'http://127.0.0.1:5984/movies';
        document.getElementById('remoteCouchUrl').value = url;
        remoteDB = new PouchDB(url, { skip_setup: false });
        logTerminal(`Sync target switched to Live CouchDB URL: ${url}`, 'warn');
      } else {
        liveContainer.classList.add('hidden');
        badge.innerText = 'Mock Remote';
        badge.className = 'text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-cyan-950 text-cyan-300 border border-cyan-800';
        remoteDB = new PouchDB(VIRTUAL_REMOTE_DB_NAME);
        logTerminal('Sync target switched to Virtual Remote DB (In-Browser Simulation).', 'info');
      }

      startReplicationEngine();
      updateRemoteDocCount();
    }

    // ==========================================
    // 4. SIMULATED & NATIVE NETWORK CONTROLLER
    // ==========================================
    function setSimulatedNetwork(online) {
      isSimulatedOffline = !online;
      updateNetworkStatusUI(online);
      
      if (online) {
        logTerminal('Network state changed: ONLINE. Re-activating synchronization...', 'success');
        showToast('Network restored to ONLINE. Re-syncing...', 'success');
        startReplicationEngine();
      } else {
        logTerminal('Network state changed: OFFLINE. Replication isolated.', 'warn');
        showToast('Network turned OFFLINE. All operations are local-only.', 'warn');
        if (syncHandler) {
          syncHandler.cancel();
          syncHandler = null;
        }
        updateSyncBadge('offline', 'Disconnected (Offline)');
      }
    }

    function updateNetworkStatusUI(online) {
      isNetworkOnline = online;
      const btnOn = document.getElementById('btnNetworkOnline');
      const btnOff = document.getElementById('btnNetworkOffline');

      if (online && !isSimulatedOffline) {
        btnOn.className = "flex items-center space-x-1.5 px-3 py-1 rounded-lg text-xs font-semibold transition bg-emerald-600 text-white shadow-sm";
        btnOff.className = "flex items-center space-x-1.5 px-3 py-1 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition";
      } else {
        btnOn.className = "flex items-center space-x-1.5 px-3 py-1 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition";
        btnOff.className = "flex items-center space-x-1.5 px-3 py-1 rounded-lg text-xs font-semibold transition bg-rose-600 text-white shadow-sm";
      }
    }

    function updateSyncBadge(state, text) {
      const badge = document.getElementById('syncBadge');
      const dot = document.getElementById('syncIndicatorDot');
      const statusText = document.getElementById('syncStatusText');

      statusText.innerText = text;
      dot.className = "w-2.5 h-2.5 rounded-full";

      if (state === 'syncing') {
        dot.classList.add('bg-cyan-400', 'pulse-sync');
        badge.className = "flex items-center space-x-2 px-3 py-1.5 rounded-lg border text-xs font-medium bg-cyan-950/40 border-cyan-800 text-cyan-300";
      } else if (state === 'active') {
        dot.classList.add('bg-emerald-400');
        badge.className = "flex items-center space-x-2 px-3 py-1.5 rounded-lg border text-xs font-medium bg-emerald-950/40 border-emerald-800 text-emerald-300";
      } else if (state === 'offline') {
        dot.classList.add('bg-rose-500');
        badge.className = "flex items-center space-x-2 px-3 py-1.5 rounded-lg border text-xs font-medium bg-rose-950/40 border-rose-800 text-rose-300";
      } else if (state === 'error') {
        dot.classList.add('bg-amber-400');
        badge.className = "flex items-center space-x-2 px-3 py-1.5 rounded-lg border text-xs font-medium bg-amber-950/40 border-amber-800 text-amber-300";
      } else {
        dot.classList.add('bg-slate-500');
        badge.className = "flex items-center space-x-2 px-3 py-1.5 rounded-lg border text-xs font-medium bg-slate-800 border-slate-700 text-slate-400";
      }
    }

    // ==========================================
    // 5. CRUD OPERATIONS (SCHEMA_A IMPLEMENTATION)
    // ==========================================
    async function handleMovieFormSubmit(event) {
      event.preventDefault();

      const id = document.getElementById('movieId').value.trim();
      const title = document.getElementById('movieTitle').value.trim();
      const actorsRaw = document.getElementById('movieActors').value;
      const genresRaw = document.getElementById('movieGenres').value;
      const rev = document.getElementById('movieDocRev').value.trim();

      if (!id || !title) {
        showToast('Movie_ID and Title are mandatory fields!', 'error');
        return;
      }

      // Format arrays strictly per Schema_A requirements
      const actors = actorsRaw.split(',').map(s => s.trim()).filter(Boolean);
      const genres = genresRaw.split(',').map(s => s.trim()).filter(Boolean);

      // Schema_A Object Model
      const movieDoc = {
        _id: id,
        Title: title,
        Actors: actors,
        Genres: genres
      };

      if (rev) {
        movieDoc._rev = rev;
      }

      try {
        const response = await localDB.put(movieDoc);
        logTerminal(`[CRUD] Saved document "${movieDoc._id}" (Rev: ${response.rev}) to local PouchDB`, 'success');
        showToast(rev ? 'Movie updated locally!' : 'Movie created locally in PouchDB!', 'success');
        resetMovieForm();
        await refreshLocalMovies();
      } catch (err) {
        if (err.name === 'conflict') {
          showToast('Update Conflict! Please inspect the document revisions.', 'error');
          logTerminal(`[CRUD Error] Document update conflict on ${movieDoc._id}: ${err.message}`, 'error');
        } else {
          showToast(`Error saving movie: ${err.message}`, 'error');
          logTerminal(`[CRUD Error] ${err.message}`, 'error');
        }
      }
    }

    async function editMovie(id) {
      try {
        const doc = await localDB.get(id);
        document.getElementById('movieId').value = doc._id;
        document.getElementById('movieId').disabled = true;
        document.getElementById('movieTitle').value = doc.Title || '';
        document.getElementById('movieActors').value = Array.isArray(doc.Actors) ? doc.Actors.join(', ') : '';
        document.getElementById('movieGenres').value = Array.isArray(doc.Genres) ? doc.Genres.join(', ') : '';
        document.getElementById('movieDocRev').value = doc._rev;

        // UI toggles
        document.getElementById('formHeading').innerHTML = `<i class="fa-solid fa-pen-to-square text-amber-400 mr-2"></i>Edit Movie (${doc._id})`;
        document.getElementById('submitBtnText').innerText = 'Update Movie in Local DB';
        document.getElementById('submitMovieBtn').className = "w-full py-2.5 px-4 bg-amber-600 hover:bg-amber-500 text-white font-medium text-xs rounded-xl shadow-lg transition flex items-center justify-center space-x-2";
        document.getElementById('cancelEditBtn').classList.remove('hidden');

        showToast(`Editing ${doc._id}. Revision: ${doc._rev}`, 'info');
      } catch (err) {
        showToast(`Failed to load document: ${err.message}`, 'error');
      }
    }

    function resetMovieForm() {
      document.getElementById('movieForm').reset();
      document.getElementById('movieId').disabled = false;
      document.getElementById('movieDocRev').value = '';
      document.getElementById('formHeading').innerHTML = `<i class="fa-solid fa-film text-indigo-400 mr-2"></i>Create Movie (Schema_A)`;
      document.getElementById('submitBtnText').innerText = 'Save to Local PouchDB';
      document.getElementById('submitMovieBtn').className = "w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white font-medium text-xs rounded-xl shadow-lg shadow-indigo-600/30 transition flex items-center justify-center space-x-2";
      document.getElementById('cancelEditBtn').classList.add('hidden');
    }

    async function deleteMovie(id) {
      try {
        const doc = await localDB.get(id);
        const result = await localDB.remove(doc);
        logTerminal(`[CRUD] Deleted doc "${id}" (Attached tombstone rev: ${result.rev})`, 'warn');
        showToast(`Deleted movie: ${id}`, 'success');
        await refreshLocalMovies();
      } catch (err) {
        showToast(`Delete failed: ${err.message}`, 'error');
        logTerminal(`[CRUD Error] Failed to delete: ${err.message}`, 'error');
      }
    }

    async function refreshLocalMovies() {
      try {
        // Query local PouchDB including conflicts flag to detect multi-master divergence
        const result = await localDB.allDocs({
          include_docs: true,
          conflicts: true
        });

        cachedMovies = result.rows.map(row => row.doc);
        document.getElementById('localDocCountBadge').innerText = `${cachedMovies.length} docs`;
        renderMovieList();
      } catch (err) {
        logTerminal(`Error fetching local documents: ${err.message}`, 'error');
      }
    }

    function renderMovieList() {
      const tbody = document.getElementById('movieTableBody');
      const emptyState = document.getElementById('emptyMovieState');
      const search = (document.getElementById('searchInput').value || '').toLowerCase().trim();

      const filtered = cachedMovies.filter(movie => {
        if (!search) return true;
        const inId = (movie._id || '').toLowerCase().includes(search);
        const inTitle = (movie.Title || '').toLowerCase().includes(search);
        const inActors = (movie.Actors || []).some(a => a.toLowerCase().includes(search));
        const inGenres = (movie.Genres || []).some(g => g.toLowerCase().includes(search));
        return inId || inTitle || inActors || inGenres;
      });

      tbody.innerHTML = '';

      if (filtered.length === 0) {
        emptyState.classList.remove('hidden');
        emptyState.classList.add('flex');
        return;
      } else {
        emptyState.classList.add('hidden');
        emptyState.classList.remove('flex');
      }

      filtered.forEach(movie => {
        const tr = document.createElement('tr');
        tr.className = "hover:bg-slate-800/40 border-b border-slate-800/60 transition group";

        const hasConflicts = movie._conflicts && movie._conflicts.length > 0;

        // Actors pills
        const actorsHtml = (movie.Actors && movie.Actors.length > 0)
          ? movie.Actors.map(a => `<span class="inline-block bg-slate-800 border border-slate-700 text-slate-300 text-[10px] px-1.5 py-0.5 rounded mr-1 mb-1">${escapeHtml(a)}</span>`).join('')
          : '<span class="text-slate-500 italic text-[10px]">None</span>';

        // Genres pills
        const genresHtml = (movie.Genres && movie.Genres.length > 0)
          ? movie.Genres.map(g => `<span class="inline-block bg-indigo-950/60 border border-indigo-800/60 text-indigo-300 text-[10px] px-1.5 py-0.5 rounded mr-1 mb-1">${escapeHtml(g)}</span>`).join('')
          : '<span class="text-slate-500 italic text-[10px]">None</span>';

        // Rev shortener
        const shortRev = movie._rev ? movie._rev.substring(0, 10) + '...' : 'pending';

        tr.innerHTML = `
          <td class="py-3 px-3 font-mono text-slate-200 font-medium">
            <div class="flex items-center space-x-1.5">
              <span>${escapeHtml(movie._id)}</span>
              ${hasConflicts ? `
                <button onclick="inspectConflicts('${escapeHtml(movie._id)}')" class="px-1.5 py-0.5 rounded bg-purple-500/20 text-purple-300 border border-purple-500/40 text-[9px] font-sans font-bold pulse-sync" title="Conflict exists on this document! Click to resolve.">
                  <i class="fa-solid fa-code-fork mr-1"></i>Conflict
                </button>
              ` : ''}
            </div>
          </td>
          <td class="py-3 px-3 font-semibold text-slate-100">${escapeHtml(movie.Title || 'Untitled')}</td>
          <td class="py-3 px-3 max-w-[200px]">${actorsHtml}</td>
          <td class="py-3 px-3 max-w-[160px]">${genresHtml}</td>
          <td class="py-3 px-3 font-mono text-[10px] text-slate-400" title="${movie._rev || ''}">
            <span class="px-1.5 py-0.5 rounded bg-slate-900 border border-slate-800">${shortRev}</span>
          </td>
          <td class="py-3 px-3 text-right space-x-1 whitespace-nowrap">
            <button onclick="editMovie('${escapeHtml(movie._id)}')" class="p-1.5 rounded-lg bg-slate-700/60 hover:bg-amber-500/20 text-slate-300 hover:text-amber-300 transition" title="Edit Movie">
              <i class="fa-solid fa-pen-to-square"></i>
            </button>
            <button onclick="inspectConflicts('${escapeHtml(movie._id)}')" class="p-1.5 rounded-lg bg-slate-700/60 hover:bg-purple-500/20 text-slate-300 hover:text-purple-300 transition" title="Inspect Revision Tree">
              <i class="fa-solid fa-code-branch"></i>
            </button>
            <button onclick="deleteMovie('${escapeHtml(movie._id)}')" class="p-1.5 rounded-lg bg-slate-700/60 hover:bg-rose-500/20 text-slate-300 hover:text-rose-400 transition" title="Delete Movie">
              <i class="fa-solid fa-trash"></i>
            </button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    async function updateRemoteDocCount() {
      try {
        const info = await remoteDB.info();
        document.getElementById('remoteDocCount').innerText = `${info.doc_count} docs (Seq: ${info.update_seq})`;
      } catch (e) {
        document.getElementById('remoteDocCount').innerText = 'Unreachable';
      }
    }

    // ==========================================
    // 6. SCENARIO DEMONSTRATION & EVALUATION SUITE
    // ==========================================
    async function runScenario(scenarioNum) {
      logTerminal(`-----------------------------------------------------`, 'warn');
      logTerminal(`STARTING EVALUATION SCENARIO ${scenarioNum}`, 'warn');

      switch (scenarioNum) {
        case 1:
          await executeScenario1_CreateOffline();
          break;
        case 2:
          await executeScenario2_UpdateOffline();
          break;
        case 3:
          await executeScenario3_DeleteOffline();
          break;
        case 4:
          await executeScenario4_SyncOnReconnect();
          break;
        case 5:
          await executeScenario5_ConflictUpdate();
          break;
      }
    }

    // Scenario 1: Create while offline
    async function executeScenario1_CreateOffline() {
      showToast('Scenario 1: Disconnecting network & inserting offline doc...', 'info');
      setSimulatedNetwork(false);

      const uniqueId = `mov-matrix-${Date.now().toString().slice(-4)}`;
      const doc = {
        _id: uniqueId,
        Title: "The Matrix (Offline Added)",
        Actors: ["Keanu Reeves", "Laurence Fishburne", "Carrie-Anne Moss"],
        Genres: ["Sci-Fi", "Action"]
      };

      await sleep(400);
      try {
        const res = await localDB.put(doc);
        logTerminal(`[Scenario 1] Document written to local PouchDB while OFFLINE: ${res.id} (rev: ${res.rev})`, 'success');
        logTerminal(`[Scenario 1] Checking remote CouchDB: Document should NOT exist on remote yet...`, 'info');
        
        try {
          await remoteDB.get(uniqueId);
          logTerminal(`[Scenario 1 Alert] Doc unexpectedly found in remote!`, 'error');
        } catch (e) {
          logTerminal(`[Scenario 1 Confirmed] Remote check returned 404 Not Found as expected while isolated.`, 'success');
        }

        await refreshLocalMovies();
        showToast(`Created ${uniqueId} offline. Queued for reconnection.`, 'success');
      } catch (err) {
        logTerminal(`Scenario 1 error: ${err.message}`, 'error');
      }
    }

    // Scenario 2: Update while offline
    async function executeScenario2_UpdateOffline() {
      showToast('Scenario 2: Mutating document offline...', 'info');
      setSimulatedNetwork(false);

      // Ensure at least one doc exists to mutate
      let targetDoc;
      try {
        const all = await localDB.allDocs({ include_docs: true, limit: 1 });
        if (all.rows.length === 0) {
          // Create baseline first
          await localDB.put({
            _id: "mov-interstellar",
            Title: "Interstellar",
            Actors: ["Matthew McConaughey", "Anne Hathaway"],
            Genres: ["Sci-Fi", "Drama"]
          });
          targetDoc = await localDB.get("mov-interstellar");
        } else {
          targetDoc = all.rows[0].doc;
        }
      } catch (e) {
        logTerminal(`Scenario 2 preparation failed: ${e.message}`, 'error');
        return;
      }

      // Modify the document offline
      const previousRev = targetDoc._rev;
      targetDoc.Title = targetDoc.Title + " [Offline Updated " + new Date().toLocaleTimeString() + "]";
      if (!targetDoc.Genres.includes("Adventure")) targetDoc.Genres.push("Adventure");

      await sleep(300);
      try {
        const updateRes = await localDB.put(targetDoc);
        logTerminal(`[Scenario 2] Local doc ${targetDoc._id} mutated offline. Rev bumped: ${previousRev} -> ${updateRes.rev}`, 'success');
        logTerminal(`[Scenario 2] Changes are logged in local IndexedDB changes feed. Remote is not notified.`, 'info');
        await refreshLocalMovies();
        showToast(`Updated ${targetDoc._id} offline to rev ${updateRes.rev}`, 'success');
      } catch (err) {
        logTerminal(`Scenario 2 update error: ${err.message}`, 'error');
      }
    }

    // Scenario 3: Delete while offline
    async function executeScenario3_DeleteOffline() {
      showToast('Scenario 3: Deleting document offline (tombstone pattern)...', 'info');
      setSimulatedNetwork(false);

      // Create a temporary document to delete if none available
      const tempId = `mov-tombstone-${Date.now().toString().slice(-4)}`;
      await localDB.put({
        _id: tempId,
        Title: "Temporary Movie to Delete",
        Actors: ["Test Actor"],
        Genres: ["Comedy"]
      });
      await refreshLocalMovies();
      await sleep(400);

      const docToDelete = await localDB.get(tempId);
      const res = await localDB.remove(docToDelete);
      
      logTerminal(`[Scenario 3] Document ${tempId} deleted offline. Tombstone revision registered: ${res.rev}`, 'warn');
      logTerminal(`[Scenario 3] PouchDB attached '_deleted: true'. Document is purged from standard views but preserved in revision log.`, 'info');
      await refreshLocalMovies();
      showToast(`Deleted ${tempId} offline. Tombstone stored locally.`, 'success');
    }

    // Scenario 4: Synchronising after reconnecting
    async function executeScenario4_SyncOnReconnect() {
      showToast('Scenario 4: Reconnecting network and activating replication...', 'info');
      logTerminal('[Scenario 4] Triggering reconnection: Setting network ONLINE...', 'info');
      setSimulatedNetwork(true);

      // Replication will automatically trigger via startReplicationEngine()
      // Let's monitor the delta
      await sleep(1000);
      await refreshLocalMovies();
      await updateRemoteDocCount();
      logTerminal('[Scenario 4] Reconnection sync cycle complete. Local and remote databases verified in parity.', 'success');
      showToast('Reconnection sync finished! Remote & Local aligned.', 'success');
    }

    // Scenario 5: Conflict update & multi-master resolution
    async function executeScenario5_ConflictUpdate() {
      showToast('Scenario 5: Simulating concurrent multi-master conflict...', 'info');
      logTerminal('[Scenario 5] 1. Disconnecting network to isolate replicas...', 'warn');
      setSimulatedNetwork(false);

      const conflictDocId = 'mov-gladiator-conflict-demo';

      // 1. Ensure a shared base ancestor exists in both local and remote
      const baseAncestor = {
        _id: conflictDocId,
        Title: "Gladiator (Original Baseline)",
        Actors: ["Russell Crowe", "Joaquin Phoenix"],
        Genres: ["Action", "Drama"]
      };

      try {
        await localDB.put(baseAncestor);
      } catch (e) { /* ignore if already exists */ }

      try {
        await remoteDB.put(baseAncestor);
      } catch (e) { /* ignore if already exists */ }

      const localBase = await localDB.get(conflictDocId);
      const remoteBase = await remoteDB.get(conflictDocId);

      logTerminal(`[Scenario 5] Base revision aligned on both nodes: ${localBase._rev}`, 'info');

      // 2. Client A (Local PouchDB) mutates while disconnected
      localBase.Title = "Gladiator: Local Branch Edition (Director's Cut)";
      localBase.Genres.push("Historical");
      const localRes = await localDB.put(localBase);
      logTerminal(`[Scenario 5] Local node mutated to rev: ${localRes.rev}`, 'info');

      // 3. Client B (Remote CouchDB) concurrently mutates same base revision
      remoteBase.Title = "Gladiator: Remote Branch Edition (Colosseum Master)";
      remoteBase.Actors.push("Connie Nielsen");
      const remoteRes = await remoteDB.put(remoteBase);
      logTerminal(`[Scenario 5] Remote node mutated to rev: ${remoteRes.rev}`, 'info');

      logTerminal(`[Scenario 5] Concurrent conflicting leaf revisions generated! Connecting and triggering sync...`, 'warn');
      
      // 4. Reconnect network
      setSimulatedNetwork(true);
      await sleep(1200);

      // Force explicit two-way sync pass to ensure conflict is ingested
      await PouchDB.sync(localDB, remoteDB);

      // 5. Inspect resulting document
      const resolvedDoc = await localDB.get(conflictDocId, { conflicts: true });
      logTerminal(`[Scenario 5 Determinism] CouchDB selected winning rev: ${resolvedDoc._rev} (${resolvedDoc.Title})`, 'success');
      
      if (resolvedDoc._conflicts && resolvedDoc._conflicts.length > 0) {
        logTerminal(`[Scenario 5 Conflict Detected] Conflicting branch revisions: ${JSON.stringify(resolvedDoc._conflicts)}`, 'warn');
        showToast('Multi-master conflict created! Opening Conflict Resolver...', 'info');
        await refreshLocalMovies();
        inspectConflicts(conflictDocId);
      } else {
        logTerminal(`[Scenario 5] Resolving sync...`, 'info');
        await refreshLocalMovies();
      }
    }

    // ==========================================
    // 7. CONFLICT INSPECTION & RESOLVER MODAL
    // ==========================================
    async function inspectConflicts(id) {
      try {
        // Fetch document including conflict revision branches
        const doc = await localDB.get(id, { conflicts: true });
        const modal = document.getElementById('conflictModal');
        const container = document.getElementById('conflictComparisonContainer');

        container.innerHTML = '';

        // Winner Card
        const winnerCard = document.createElement('div');
        winnerCard.className = "bg-slate-950 border-2 border-emerald-500/80 rounded-xl p-4 space-y-2 relative";
        winnerCard.innerHTML = `
          <div class="flex items-center justify-between pb-2 border-b border-slate-800">
            <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider flex items-center">
              <i class="fa-solid fa-trophy mr-1.5"></i> Deterministic Winner
            </span>
            <span class="text-[10px] font-mono bg-emerald-950 text-emerald-300 px-2 py-0.5 rounded border border-emerald-800">
              ${doc._rev}
            </span>
          </div>
          <div>
            <div class="text-[11px] text-slate-400">Title</div>
            <div class="text-xs font-semibold text-slate-100">${escapeHtml(doc.Title)}</div>
          </div>
          <div>
            <div class="text-[11px] text-slate-400">Actors</div>
            <div class="text-xs text-slate-300">${(doc.Actors || []).join(', ')}</div>
          </div>
          <div>
            <div class="text-[11px] text-slate-400">Genres</div>
            <div class="text-xs text-slate-300">${(doc.Genres || []).join(', ')}</div>
          </div>
          <div class="pt-3">
            <button onclick="resolveConflictKeepWinner('${escapeHtml(doc._id)}')" class="w-full py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-semibold transition">
              Keep This Winner (Delete Conflicting Branch)
            </button>
          </div>
        `;
        container.appendChild(winnerCard);

        // Conflicting Branches Cards
        if (doc._conflicts && doc._conflicts.length > 0) {
          for (const conflictRev of doc._conflicts) {
            const conflictDoc = await localDB.get(id, { rev: conflictRev });
            const conflictCard = document.createElement('div');
            conflictCard.className = "bg-slate-950 border-2 border-amber-500/80 rounded-xl p-4 space-y-2 relative";
            conflictCard.innerHTML = `
              <div class="flex items-center justify-between pb-2 border-b border-slate-800">
                <span class="text-xs font-bold text-amber-400 uppercase tracking-wider flex items-center">
                  <i class="fa-solid fa-code-fork mr-1.5"></i> Conflicting Revision
                </span>
                <span class="text-[10px] font-mono bg-amber-950 text-amber-300 px-2 py-0.5 rounded border border-amber-800">
                  ${conflictDoc._rev}
                </span>
              </div>
              <div>
                <div class="text-[11px] text-slate-400">Title</div>
                <div class="text-xs font-semibold text-slate-100">${escapeHtml(conflictDoc.Title)}</div>
              </div>
              <div>
                <div class="text-[11px] text-slate-400">Actors</div>
                <div class="text-xs text-slate-300">${(conflictDoc.Actors || []).join(', ')}</div>
              </div>
              <div>
                <div class="text-[11px] text-slate-400">Genres</div>
                <div class="text-xs text-slate-300">${(conflictDoc.Genres || []).join(', ')}</div>
              </div>
              <div class="pt-3">
                <button onclick="resolveConflictPickAlternative('${escapeHtml(doc._id)}', '${escapeHtml(conflictRev)}')" class="w-full py-2 bg-amber-600 hover:bg-amber-500 text-white rounded-lg text-xs font-semibold transition">
                  Choose This Branch Over Winner
                </button>
              </div>
            `;
            container.appendChild(conflictCard);
          }
        } else {
          const noConflictNotice = document.createElement('div');
          noConflictNotice.className = "bg-slate-950 border border-slate-800 rounded-xl p-4 flex items-center justify-center text-slate-400 text-xs text-center";
          noConflictNotice.innerHTML = `
            <div>
              <i class="fa-solid fa-check-circle text-emerald-400 text-2xl mb-2"></i>
              <p>No active conflicting leaf revisions detected on document ${id}. Revision tree is linear.</p>
            </div>
          `;
          container.appendChild(noConflictNotice);
        }

        modal.classList.remove('hidden');
      } catch (err) {
        showToast(`Could not inspect conflicts: ${err.message}`, 'error');
      }
    }

    function closeConflictModal() {
      document.getElementById('conflictModal').classList.add('hidden');
    }

    // Conflict Resolution: Keep current winner and remove conflicting revisions
    async function resolveConflictKeepWinner(id) {
      try {
        const doc = await localDB.get(id, { conflicts: true });
        if (doc._conflicts) {
          for (const rev of doc._conflicts) {
            await localDB.remove(id, rev);
            logTerminal(`[Conflict Resolution] Purged conflicting branch rev ${rev} on doc ${id}`, 'success');
          }
        }
        showToast('Conflicts resolved successfully! Linear history restored.', 'success');
        closeConflictModal();
        await refreshLocalMovies();
      } catch (err) {
        showToast(`Resolution error: ${err.message}`, 'error');
      }
    }

    // Conflict Resolution: Pick alternative revision as winner
    async function resolveConflictPickAlternative(id, chosenRev) {
      try {
        const chosenDoc = await localDB.get(id, { rev: chosenRev });
        const currentWinner = await localDB.get(id);

        // Overwrite winner's body with chosen doc's contents
        currentWinner.Title = chosenDoc.Title;
        currentWinner.Actors = chosenDoc.Actors;
        currentWinner.Genres = chosenDoc.Genres;

        // Save new revision on top of winner
        await localDB.put(currentWinner);

        // Remove the alternative branch so conflict is cleared
        await localDB.remove(id, chosenRev);

        logTerminal(`[Conflict Resolution] Selected rev ${chosenRev} as new canonical content. Linearized branch.`, 'success');
        showToast('Selected branch promoted to canonical winner!', 'success');
        closeConflictModal();
        await refreshLocalMovies();
      } catch (err) {
        showToast(`Resolution error: ${err.message}`, 'error');
      }
    }

    // ==========================================
    // 8. HELPERS, SEEDING & TERMINAL LOGGING
    // ==========================================
    async function seedInitialDataIfEmpty() {
      try {
        const info = await localDB.info();
        if (info.doc_count === 0) {
          logTerminal('Local database empty. Seeding Schema_A initial movies...', 'info');
          const sampleMovies = [
            {
              _id: 'mov-interstellar-2014',
              Title: 'Interstellar',
              Actors: ['Matthew McConaughey', 'Anne Hathaway', 'Jessica Chastain'],
              Genres: ['Sci-Fi', 'Adventure', 'Drama']
            },
            {
              _id: 'mov-dark-knight-2008',
              Title: 'The Dark Knight',
              Actors: ['Christian Bale', 'Heath Ledger', 'Gary Oldman'],
              Genres: ['Action', 'Crime', 'Drama']
            },
            {
              _id: 'mov-spirited-away-2001',
              Title: 'Spirited Away',
              Actors: ['Rumi Hiiragi', 'Miyu Irino'],
              Genres: ['Animation', 'Adventure', 'Family']
            }
          ];

          for (const movie of sampleMovies) {
            await localDB.put(movie);
          }
          logTerminal(`Seeded ${sampleMovies.length} initial movies locally.`, 'success');
        }
      } catch (err) {
        logTerminal(`Error during database seeding: ${err.message}`, 'error');
      }
    }

    async function resetDatabases() {
      if (!confirm('Are you sure you want to reset both local and mock remote databases?')) return;

      logTerminal('Resetting local PouchDB and mock remote CouchDB...', 'warn');
      if (syncHandler) syncHandler.cancel();

      await localDB.destroy();
      await remoteDB.destroy();

      localDB = new PouchDB(LOCAL_DB_NAME);
      remoteDB = new PouchDB(VIRTUAL_REMOTE_DB_NAME);

      cachedMovies = [];
      await seedInitialDataIfEmpty();
      await refreshLocalMovies();
      await updateRemoteDocCount();
      startReplicationEngine();

      showToast('Databases recreated and re-seeded!', 'info');
    }

    function generateRandomMovieId() {
      const titles = ['alien', 'blade-runner', 'dune', 'pulp-fiction', 'godfather', 'parasite'];
      const randomTitle = titles[Math.floor(Math.random() * titles.length)];
      const randNum = Math.floor(100 + Math.random() * 900);
      document.getElementById('movieId').value = `mov-${randomTitle}-${randNum}`;
    }

    function toggleAcademicModal(show) {
      const modal = document.getElementById('academicModal');
      if (show) {
        modal.classList.remove('hidden');
      } else {
        modal.classList.add('hidden');
      }
    }

    function logTerminal(message, type = 'info') {
      const stream = document.getElementById('terminalStream');
      const time = new Date().toLocaleTimeString();
      const div = document.createElement('div');
      div.className = "flex items-start space-x-2";

      let color = 'text-slate-300';
      let icon = '<i class="fa-solid fa-angle-right text-slate-500 text-[10px] mt-0.5"></i>';

      if (type === 'success') {
        color = 'text-emerald-400';
        icon = '<i class="fa-solid fa-check text-emerald-400 text-[10px] mt-0.5"></i>';
      } else if (type === 'warn') {
        color = 'text-amber-400';
        icon = '<i class="fa-solid fa-triangle-exclamation text-amber-400 text-[10px] mt-0.5"></i>';
      } else if (type === 'error') {
        color = 'text-rose-400 font-semibold';
        icon = '<i class="fa-solid fa-xmark text-rose-400 text-[10px] mt-0.5"></i>';
      }

      div.innerHTML = `
        <span class="text-slate-600 select-none text-[10px]">${time}</span>
        ${icon}
        <span class="${color} break-all">${escapeHtml(message)}</span>
      `;

      stream.appendChild(div);
      stream.scrollTop = stream.scrollHeight;
    }

    function clearTerminalLogs() {
      document.getElementById('terminalStream').innerHTML = '';
      logTerminal('Terminal buffer cleared.', 'info');
    }

    function showToast(message, type = 'info') {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');

      let bg = 'bg-slate-800 border-slate-700 text-slate-200';
      let icon = '<i class="fa-solid fa-circle-info text-indigo-400"></i>';

      if (type === 'success') {
        bg = 'bg-slate-900 border-emerald-600/60 text-emerald-300 shadow-emerald-950/50';
        icon = '<i class="fa-solid fa-circle-check text-emerald-400"></i>';
      } else if (type === 'warn') {
        bg = 'bg-slate-900 border-amber-600/60 text-amber-300 shadow-amber-950/50';
        icon = '<i class="fa-solid fa-triangle-exclamation text-amber-400"></i>';
      } else if (type === 'error') {
        bg = 'bg-slate-900 border-rose-600/60 text-rose-300 shadow-rose-950/50';
        icon = '<i class="fa-solid fa-circle-xmark text-rose-400"></i>';
      }

      toast.className = `${bg} pointer-events-auto border px-4 py-3 rounded-xl shadow-xl text-xs flex items-center space-x-2.5 transition transform duration-200 translate-y-2 opacity-0 max-w-sm`;
      toast.innerHTML = `${icon}<span>${escapeHtml(message)}</span>`;

      container.appendChild(toast);

      requestAnimationFrame(() => {
        toast.classList.remove('translate-y-2', 'opacity-0');
      });

      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 250);
      }, 4000);
    }

    function escapeHtml(str) {
      if (typeof str !== 'string') return str;
      return str.replace(/[&<>'"]/g, 
        tag => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          "'": '&#39;',
          '"': '&quot;'
        }[tag] || tag)
      );
    }

    function sleep(ms) {
      return new Promise(resolve => setTimeout(resolve, ms));
    }
  </script>
