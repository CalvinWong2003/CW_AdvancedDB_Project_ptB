<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Offline-First Movie Sync (PouchDB & CouchDB)</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- PouchDB Official Library CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pouchdb/8.0.1/pouchdb.min.js"></script>
  <!-- FontAwesome Icons for clean UI symbols -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#eef2ff',
              100: '#e0e7ff',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
              900: '#312e81'
            }
          }
        }
      }
    };
  </script>
  <style>
    /* Custom scrollbar and terminal font styling */
    .terminal-scroll::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    .terminal-scroll::-webkit-scrollbar-track {
      background: #111827;
    }
    .terminal-scroll::-webkit-scrollbar-thumb {
      background: #374151;
      border-radius: 3px;
    }
    .pulse-sync {
      animation: pulseSync 1.5s infinite;
    }
    @keyframes pulseSync {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.6; transform: scale(1.05); }
    }
  </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col font-sans antialiased selection:bg-indigo-500 selection:text-white">

  <!-- TOP NAVIGATION & STATUS BAR -->
  <header class="border-b border-slate-800 bg-slate-900/90 backdrop-blur sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
      
      <!-- Brand & Schema Indicator -->
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-indigo-600 flex items-center justify-center shadow-lg shadow-indigo-600/30">
          <i class="fa-solid fa-film text-lg text-white"></i>
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <h1 class="font-bold text-lg text-white tracking-tight">MovieSync</h1>
            <span class="text-xs px-2 py-0.5 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 font-mono">Schema_A</span>
          </div>
          <p class="text-xs text-slate-400 hidden sm:block">Offline-First PouchDB & CouchDB Protocol Demonstrator</p>
        </div>
      </div>

      <!-- Controls: Network Simulation & Replication State -->
      <div class="flex items-center space-x-2 sm:space-x-4">
        <!-- Live Replication State Pill -->
        <div id="syncBadge" class="flex items-center space-x-2 px-3 py-1.5 rounded-lg border text-xs font-medium bg-slate-800 border-slate-700 text-slate-300">
          <span id="syncIndicatorDot" class="w-2.5 h-2.5 rounded-full bg-slate-500"></span>
          <span id="syncStatusText">Replication Idle</span>
        </div>

        <!-- Simulated Network Switch -->
        <div class="flex items-center bg-slate-800 p-1 rounded-xl border border-slate-700">
          <button id="btnNetworkOnline" onclick="setSimulatedNetwork(true)" class="flex items-center space-x-1.5 px-3 py-1 rounded-lg text-xs font-semibold transition bg-emerald-600 text-white shadow-sm">
            <i class="fa-solid fa-wifi text-xs"></i>
            <span>Online</span>
          </button>
          <button id="btnNetworkOffline" onclick="setSimulatedNetwork(false)" class="flex items-center space-x-1.5 px-3 py-1 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition">
            <i class="fa-solid fa-plane-slash text-xs"></i>
            <span>Offline</span>
          </button>
        </div>

        <!-- Academic Report Modal Toggle -->
        <button onclick="toggleAcademicModal(true)" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 rounded-lg text-xs font-semibold flex items-center space-x-2 transition" title="Academic Evaluation and Architecture Specs">
          <i class="fa-solid fa-graduation-cap text-indigo-400"></i>
          <span class="hidden md:inline">Evaluation Report (10 Marks)</span>
        </button>
      </div>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- SCENARIOS DEMONSTRATION WORKBENCH (Academic Requirement: 10 Marks) -->
    <section class="bg-slate-800/80 border border-slate-700/80 rounded-2xl p-4 sm:p-5 shadow-xl backdrop-blur">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-slate-700 gap-3">
        <div>
          <div class="flex items-center space-x-2">
            <span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-amber-500/20 text-amber-400 text-xs font-bold">5</span>
            <h2 class="text-sm font-semibold tracking-wide uppercase text-slate-200">Evaluation Scenario Suite</h2>
          </div>
          <p class="text-xs text-slate-400 mt-0.5">Automate and evaluate the mandatory behaviors: offline writes, reconnect replication, & conflict updates.</p>
        </div>
        <div class="flex items-center space-x-2 text-xs">
          <button onclick="resetDatabases()" class="px-2.5 py-1.5 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 transition flex items-center space-x-1.5">
            <i class="fa-solid fa-rotate-left text-xs"></i>
            <span>Reset Demo DBs</span>
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-3 mt-4">
        <!-- Scenario 1 -->
        <button onclick="runScenario(1)" class="group p-3 rounded-xl bg-slate-900/80 border border-slate-700 hover:border-indigo-500/50 text-left transition relative overflow-hidden flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-[11px] font-bold uppercase tracking-wider text-indigo-400">Scenario 1</span>
              <i class="fa-solid fa-plus-circle text-slate-500 group-hover:text-indigo-400 transition"></i>
            </div>
            <div class="text-xs font-semibold text-slate-200">Create Offline</div>
            <p class="text-[11px] text-slate-400 mt-1 leading-snug">Cuts network, inserts a new movie in local PouchDB, verifies local-only existence.</p>
          </div>
          <span class="mt-2 text-[10px] text-indigo-400 font-mono flex items-center space-x-1">
            <span>Execute</span> <i class="fa-solid fa-arrow-right text-[9px]"></i>
          </span>
        </button>

        <!-- Scenario 2 -->
        <button onclick="runScenario(2)" class="group p-3 rounded-xl bg-slate-900/80 border border-slate-700 hover:border-indigo-500/50 text-left transition relative overflow-hidden flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-[11px] font-bold uppercase tracking-wider text-amber-400">Scenario 2</span>
              <i class="fa-solid fa-pen-to-square text-slate-500 group-hover:text-amber-400 transition"></i>
            </div>
            <div class="text-xs font-semibold text-slate-200">Update Offline</div>
            <p class="text-[11px] text-slate-400 mt-1 leading-snug">Mutates a movie offline, bumping local revision tree without syncing remote.</p>
          </div>
          <span class="mt-2 text-[10px] text-amber-400 font-mono flex items-center space-x-1">
            <span>Execute</span> <i class="fa-solid fa-arrow-right text-[9px]"></i>
          </span>
        </button>

        <!-- Scenario 3 -->
        <button onclick="runScenario(3)" class="group p-3 rounded-xl bg-slate-900/80 border border-slate-700 hover:border-indigo-500/50 text-left transition relative overflow-hidden flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-[11px] font-bold uppercase tracking-wider text-rose-400">Scenario 3</span>
              <i class="fa-solid fa-trash text-slate-500 group-hover:text-rose-400 transition"></i>
            </div>
            <div class="text-xs font-semibold text-slate-200">Delete Offline</div>
            <p class="text-[11px] text-slate-400 mt-1 leading-snug">Applies `_deleted: true` tombstone locally while in disconnected mode.</p>
          </div>
          <span class="mt-2 text-[10px] text-rose-400 font-mono flex items-center space-x-1">
            <span>Execute</span> <i class="fa-solid fa-arrow-right text-[9px]"></i>
          </span>
        </button>

        <!-- Scenario 4 -->
        <button onclick="runScenario(4)" class="group p-3 rounded-xl bg-slate-900/80 border border-slate-700 hover:border-indigo-500/50 text-left transition relative overflow-hidden flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-[11px] font-bold uppercase tracking-wider text-emerald-400">Scenario 4</span>
              <i class="fa-solid fa-network-wired text-slate-500 group-hover:text-emerald-400 transition"></i>
            </div>
            <div class="text-xs font-semibold text-slate-200">Sync on Reconnect</div>
            <p class="text-[11px] text-slate-400 mt-1 leading-snug">Restores connectivity, fires live replication, verifies remote and local parity.</p>
          </div>
          <span class="mt-2 text-[10px] text-emerald-400 font-mono flex items-center space-x-1">
            <span>Execute</span> <i class="fa-solid fa-arrow-right text-[9px]"></i>
          </span>
        </button>

        <!-- Scenario 5 -->
        <button onclick="runScenario(5)" class="group p-3 rounded-xl bg-slate-900/80 border border-slate-700 hover:border-indigo-500/50 text-left transition relative overflow-hidden flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-[11px] font-bold uppercase tracking-wider text-purple-400">Scenario 5</span>
              <i class="fa-solid fa-code-fork text-slate-500 group-hover:text-purple-400 transition"></i>
            </div>
            <div class="text-xs font-semibold text-slate-200">Conflict Update</div>
            <p class="text-[11px] text-slate-400 mt-1 leading-snug">Edits same doc on both nodes offline, reconnects to inspect and resolve branch conflicts.</p>
          </div>
          <span class="mt-2 text-[10px] text-purple-400 font-mono flex items-center space-x-1">
            <span>Execute</span> <i class="fa-solid fa-arrow-right text-[9px]"></i>
          </span>
        </button>
      </div>
    </section>

    <!-- WORKBENCH 2-COLUMN LAYOUT -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

      <!-- LEFT COLUMN: CRUD FORM & COUCHDB CONFIG (lg:col-span-4) -->
      <div class="lg:col-span-4 space-y-6">

        <!-- MOVIE CRUD CARD (Schema_A) -->
        <div class="bg-slate-800/90 border border-slate-700 rounded-2xl p-5 shadow-lg">
          <div class="flex items-center justify-between pb-3 border-b border-slate-700">
            <h3 id="formHeading" class="text-sm font-bold text-white flex items-center space-x-2">
              <i class="fa-solid fa-film text-indigo-400"></i>
              <span>Create Movie (Schema_A)</span>
            </h3>
            <button id="cancelEditBtn" onclick="resetMovieForm()" class="hidden text-xs text-slate-400 hover:text-white">
              Cancel Edit
            </button>
          </div>

          <form id="movieForm" onsubmit="handleMovieFormSubmit(event)" class="mt-4 space-y-4">
            <!-- Hidden internal _rev for PouchDB updates -->
            <input type="hidden" id="movieDocRev" value="">
            
            <!-- Movie_ID (_id) -->
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1" for="movieId">
                Movie_ID <span class="text-indigo-400 font-mono text-[10px]">(_id)</span>
              </label>
              <div class="relative">
                <input type="text" id="movieId" required placeholder="e.g., mov-inception-2010"
                       class="w-full bg-slate-900 border border-slate-700 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 rounded-xl px-3 py-2 text-xs font-mono text-slate-100 placeholder-slate-500 transition outline-none">
                <button type="button" onclick="generateRandomMovieId()" title="Generate random ID" class="absolute right-2.5 top-2 text-slate-500 hover:text-slate-300 text-xs">
                  <i class="fa-solid fa-wand-magic-sparkles"></i>
                </button>
              </div>
              <p class="text-[10px] text-slate-400 mt-1">Unique primary key strictly mapped to PouchDB <code class="text-indigo-300">_id</code>.</p>
            </div>

            <!-- Title -->
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1" for="movieTitle">
                Title <span class="text-indigo-400 font-mono text-[10px]">(string)</span>
              </label>
              <input type="text" id="movieTitle" required placeholder="e.g., Inception"
                     class="w-full bg-slate-900 border border-slate-700 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 rounded-xl px-3 py-2 text-xs text-slate-100 placeholder-slate-500 transition outline-none">
            </div>

            <!-- Actors (Array) -->
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1" for="movieActors">
                Actors <span class="text-indigo-400 font-mono text-[10px]">(array of strings)</span>
              </label>
              <input type="text" id="movieActors" required placeholder="Comma separated: Leonardo DiCaprio, Elliot Page, Tom Hardy"
                     class="w-full bg-slate-900 border border-slate-700 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 rounded-xl px-3 py-2 text-xs text-slate-100 placeholder-slate-500 transition outline-none">
              <p class="text-[10px] text-slate-400 mt-1">Parses into: <code class="text-slate-300">["Actor 1", "Actor 2"]</code></p>
            </div>

            <!-- Genres (Array) -->
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-slate-300 mb-1" for="movieGenres">
                Genres <span class="text-indigo-400 font-mono text-[10px]">(array of strings)</span>
              </label>
              <input type="text" id="movieGenres" required placeholder="Comma separated: Sci-Fi, Action, Thriller"
                     class="w-full bg-slate-900 border border-slate-700 focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 rounded-xl px-3 py-2 text-xs text-slate-100 placeholder-slate-500 transition outline-none">
              <p class="text-[10px] text-slate-400 mt-1">Parses into: <code class="text-slate-300">["Sci-Fi", "Action"]</code></p>
            </div>

            <button type="submit" id="submitMovieBtn" class="w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-500 active:bg-indigo-700 text-white font-medium text-xs rounded-xl shadow-lg shadow-indigo-600/30 transition flex items-center justify-center space-x-2">
              <i class="fa-solid fa-floppy-disk"></i>
              <span id="submitBtnText">Save to Local PouchDB</span>
            </button>
          </form>
        </div>

        <!-- REPLICATION & COUCHDB REMOTE CONFIGURATION -->
        <div class="bg-slate-800/90 border border-slate-700 rounded-2xl p-5 shadow-lg space-y-4">
          <div class="flex items-center justify-between pb-2 border-b border-slate-700">
            <h3 class="text-sm font-bold text-white flex items-center space-x-2">
              <i class="fa-solid fa-server text-cyan-400"></i>
              <span>CouchDB Target & Sync Engine</span>
            </h3>
            <span id="engineModeBadge" class="text-[10px] uppercase font-mono px-2 py-0.5 rounded bg-cyan-950 text-cyan-300 border border-cyan-800">Mock Remote</span>
          </div>

          <div class="space-y-3">
            <div>
              <label class="block text-xs text-slate-400 mb-1">Target CouchDB Instance</label>
              <select id="syncEngineSelector" onchange="toggleSyncMode(this.value)" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs text-slate-200 outline-none">
                <option value="virtual" selected>Virtual Remote CouchDB (Zero setup, in-browser evaluation)</option>
                <option value="live">Live CouchDB Server URL (Real HTTP replication)</option>
              </select>
            </div>

            <!-- Remote URL input (Shown when live mode is selected) -->
            <div id="liveUrlContainer" class="hidden space-y-2">
              <label class="block text-xs text-slate-400">Remote CouchDB Endpoint URL</label>
              <input type="url" id="remoteCouchUrl" placeholder="http://admin:password@127.0.0.1:5984/movies"
                     class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs font-mono text-slate-200 placeholder-slate-600 outline-none">
              <p class="text-[10px] text-amber-400">Note: CouchDB must have CORS enabled (<code class="bg-slate-900 px-1 py-0.5 rounded">enable_cors = true</code>) for browser HTTP requests.</p>
            </div>

            <!-- Trigger Replication Actions -->
            <div class="grid grid-cols-2 gap-2 pt-1">
              <button onclick="triggerManualSync()" class="w-full py-2 bg-slate-700 hover:bg-slate-600 active:bg-slate-800 text-xs rounded-xl font-medium text-slate-200 transition flex items-center justify-center space-x-1.5">
                <i class="fa-solid fa-arrows-rotate text-xs"></i>
                <span>Sync Now</span>
              </button>
              <button onclick="toggleLiveSync()" id="toggleLiveSyncBtn" class="w-full py-2 bg-cyan-600/20 hover:bg-cyan-600/30 text-cyan-300 border border-cyan-500/30 text-xs rounded-xl font-medium transition flex items-center justify-center space-x-1.5">
                <i class="fa-solid fa-bolt text-xs"></i>
                <span id="liveSyncBtnText">Live Sync: ON</span>
              </button>
            </div>

            <!-- Remote Database Status Overview -->
            <div class="p-3 bg-slate-900/80 rounded-xl border border-slate-700/60 flex items-center justify-between text-xs font-mono">
              <span class="text-slate-400">Remote Doc Count:</span>
              <span id="remoteDocCount" class="font-bold text-cyan-400">0 docs</span>
            </div>
          </div>
        </div>

      </div>

      <!-- RIGHT COLUMN: MOVIES INVENTORY & REPLICATION LOGS (lg:col-span-8) -->
      <div class="lg:col-span-8 space-y-6">

        <!-- MOVIES LISTING (Filterable, Responsive Table) -->
        <div class="bg-slate-800/90 border border-slate-700 rounded-2xl p-5 shadow-lg flex flex-col min-h-[420px]">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-700">
            <div>
              <div class="flex items-center space-x-2">
                <h3 class="text-sm font-bold text-white uppercase tracking-wider">Local PouchDB Inventory</h3>
                <span id="localDocCountBadge" class="text-xs bg-indigo-500/20 text-indigo-300 px-2 py-0.5 rounded-full font-mono font-semibold">0 docs</span>
              </div>
              <p class="text-xs text-slate-400 mt-0.5">Documents persisted locally in IndexedDB using Schema_A attributes.</p>
            </div>

            <!-- Search & Filter Filter -->
            <div class="flex items-center space-x-2">
              <div class="relative">
                <input type="text" id="searchInput" oninput="renderMovieList()" placeholder="Search title, actor, genre..."
                       class="bg-slate-900 border border-slate-700 rounded-xl pl-8 pr-3 py-1.5 text-xs text-slate-200 placeholder-slate-500 outline-none focus:border-indigo-500 w-48 sm:w-64">
                <i class="fa-solid fa-magnifying-glass absolute left-2.5 top-2.5 text-slate-500 text-xs"></i>
              </div>
              <button onclick="refreshLocalMovies()" class="p-2 rounded-xl bg-slate-700 hover:bg-slate-600 text-slate-300 transition text-xs" title="Refresh list">
                <i class="fa-solid fa-rotate-right"></i>
              </button>
            </div>
          </div>

          <!-- Movie Table container -->
          <div class="overflow-x-auto flex-1 mt-4">
            <table class="w-full text-left border-collapse text-xs">
              <thead>
                <tr class="border-b border-slate-700 text-slate-400 uppercase text-[10px] tracking-wider">
                  <th class="py-2.5 px-3">Movie_ID (_id)</th>
                  <th class="py-2.5 px-3">Title</th>
                  <th class="py-2.5 px-3">Actors</th>
                  <th class="py-2.5 px-3">Genres</th>
                  <th class="py-2.5 px-3">Rev (_rev)</th>
                  <th class="py-2.5 px-3 text-right">Actions</th>
                </tr>
              </thead>
              <tbody id="movieTableBody" class="divide-y divide-slate-800/60 font-sans">
                <!-- Injected via JavaScript -->
              </tbody>
            </table>

            <!-- Empty State -->
            <div id="emptyMovieState" class="hidden flex-col items-center justify-center py-16 text-slate-500 space-y-2">
              <i class="fa-solid fa-inbox text-4xl"></i>
              <p class="text-sm font-medium">No movies found in local storage</p>
              <p class="text-xs text-slate-500">Create a movie or run Scenario 1 from the scenario panel above.</p>
            </div>
          </div>
        </div>

        <!-- REPLICATION EVENT TERMINAL LOG -->
        <div class="bg-slate-950 border border-slate-800 rounded-2xl p-4 shadow-xl font-mono text-xs">
          <div class="flex items-center justify-between pb-2 border-b border-slate-800">
            <div class="flex items-center space-x-2 text-slate-400">
              <div class="flex space-x-1">
                <span class="w-2.5 h-2.5 rounded-full bg-rose-500/80 inline-block"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-amber-500/80 inline-block"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/80 inline-block"></span>
              </div>
              <span class="text-[11px] font-semibold text-slate-300">PouchDB Replication Event Bus</span>
            </div>
            <div class="flex items-center space-x-2">
              <button onclick="clearTerminalLogs()" class="text-[10px] text-slate-500 hover:text-slate-300">Clear Logs</button>
            </div>
          </div>

          <!-- Log stream -->
          <div id="terminalStream" class="h-44 overflow-y-auto terminal-scroll mt-3 space-y-1 pr-2 text-slate-300">
            <!-- Injected via JS -->
          </div>
        </div>

      </div>
    </div>
  </main>

  <!-- REVISION INSPECTOR & CONFLICT RESOLUTION MODAL -->
  <div id="conflictModal" class="hidden fixed inset-0 z-50 bg-black/75 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-700 rounded-2xl w-full max-w-3xl overflow-hidden shadow-2xl flex flex-col max-h-[90vh]">
      <div class="p-4 border-b border-slate-800 flex items-center justify-between bg-slate-950">
        <div class="flex items-center space-x-2">
          <i class="fa-solid fa-code-branch text-purple-400"></i>
          <h3 class="font-bold text-sm text-white">Revision Tree & Conflict Resolver</h3>
        </div>
        <button onclick="closeConflictModal()" class="text-slate-400 hover:text-white">
          <i class="fa-solid fa-xmark text-sm"></i>
        </button>
      </div>

      <div class="p-5 overflow-y-auto space-y-4">
        <div class="bg-purple-950/40 border border-purple-800/60 p-3 rounded-xl text-xs text-purple-200">
          <p class="font-bold mb-1"><i class="fa-solid fa-circle-exclamation mr-1"></i> Multi-Master Conflict Detected</p>
          <p>CouchDB deterministic winning algorithm picked the revision with the highest numeric generation or hash. Both revisions remain in the tree until explicitly resolved.</p>
        </div>

        <div id="conflictComparisonContainer" class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Populated dynamically -->
        </div>
      </div>

